{
  "name": "homepage-edge",
  "version": "0.0.0",
  "private": true,
  "description": "Cloudflare Worker: edge proxy fronting the static Homepage S3 site (www→apex redirect + S3 proxy).",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:prod": "wrangler deploy --env production",
    "deploy:dev": "wrangler deploy --env dev",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.90.0"
  }
}
